# ============================================================================
# Churchill Application Portal - Production Environment Configuration
# ============================================================================
# VPS: srv1142915.hstgr.cloud (72.61.225.229)
# OS: Ubuntu 24.04 LTS
# Date: November 24, 2025
# ============================================================================

# ============================================================================
# Application
# ============================================================================
APP_NAME=Churchill Application Portal
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=False

# ============================================================================
# Database (PostgreSQL 16)
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=churchill_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE_USE_openssl_rand_hex_32
POSTGRES_DB=churchill_portal

# ============================================================================
# Security - CRITICAL: Generate new secrets for production!
# ============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CORS (Your Production Domain)
# ============================================================================
# Add your actual domain after SSL setup
BACKEND_CORS_ORIGINS=["https://portal.churchilleducation.edu.au","https://api.churchilleducation.edu.au","http://72.61.225.229"]

# ============================================================================
# Azure Services (For OCR and Document Storage)
# ============================================================================
# Get from Azure Portal
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=documents
AZURE_FORM_RECOGNIZER_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=YOUR_AZURE_FORM_RECOGNIZER_KEY
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://YOUR_ACS.communication.azure.com/;accesskey=YOUR_KEY

# ============================================================================
# Redis & Celery (Background Tasks)
# ============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================================
# Email (Fallback SMTP if not using Azure Communication Services)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@churchilleducation.edu.au
SMTP_PASSWORD=YOUR_EMAIL_APP_PASSWORD
EMAILS_FROM_EMAIL=noreply@churchilleducation.edu.au
EMAILS_FROM_NAME=Churchill Education

# ============================================================================
# File Upload
# ============================================================================
MAX_UPLOAD_SIZE_MB=20
ALLOWED_DOCUMENT_EXTENSIONS=[".pdf",".jpg",".jpeg",".png",".doc",".docx"]

# ============================================================================
# PgAdmin (Web UI for Database Management)
# ============================================================================
PGADMIN_EMAIL=admin@churchill.edu.au
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================================
# DocuSeal Integration (For Offer Letter Signatures)
# ============================================================================
DOCUSEAL_API_KEY=YOUR_DOCUSEAL_API_KEY
DOCUSEAL_API_URL=https://api.docuseal.co
DOCUSEAL_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ============================================================================
# Multi-tenancy
# ============================================================================
# This will be set automatically after first migration
CHURCHILL_RTO_ID=
